# React Native's Android build (ninja/cmake) cannot handle paths over Windows'
# 260-char MAX_PATH, and pnpm's peer-hashed store paths blow past it:
#   node_modules/.pnpm/react-native@0.76.0_@babel+core@7.29.7_.../node_modules/react-native/...
# => 284 chars for ReactAndroid/.../CallInvokerHolder.h
# A hoisted (npm-style) layout puts it at 147 chars.
# Windows long-path support is off (LongPathsEnabled=0) and ninja ignores it anyway.
node-linker=hoisted
