# EaszyGoo backend environment. Lists exactly what apps/backend reads — the
# schema in apps/backend/src/lib/env.ts is the source of truth. "Required" means
# the process refuses to start without it when NODE_ENV=production; in dev it
# only warns. Blank values count as unset.
#
# Mobile apps do NOT read this file: each Expo app reads its own
# apps/<app>/.env (EXPO_PUBLIC_API_URL).

# ---- Runtime ----
# development | test | production (default: development)
NODE_ENV=development
# HTTP port (default: 4000)
PORT=4000

# ---- Database (required: DATABASE_URL) ----
# Supabase Postgres. DATABASE_URL = transaction pooler (port 6543) for the app runtime;
# DIRECT_URL = session pooler (port 5432), read only by the Prisma CLI for migrations.
# Find both under: Supabase Dashboard -> project -> Connect.
# URL-encode special chars in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional read replica for admin list endpoints. Unset = use DATABASE_URL.
READ_REPLICA_URL=

# ---- Redis (required) ----
# One instance, DB 0 only; concerns are separated by key prefix (bull, rl:, sock, cache:).
# Must use maxmemory-policy=noeviction or BullMQ can lose jobs (logged at startup).
REDIS_URL=

# ---- Firebase Admin, OTP auth + FCM (required) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Single line, with literal \n sequences for the newlines.
FIREBASE_PRIVATE_KEY=
# Dev-only: used by `pnpm get-test-token` (Firebase client SDK). Project settings ->
# General -> your web app -> apiKey / authDomain. Not used by the app runtime.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
# Dev-only: pincodes `pnpm seed:dev` creates service zones for (default 248001,248002).
SEED_PINCODES=

# ---- Cloudinary, signed uploads (required by the API) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Sentry (optional — crash reporting is skipped when unset) ----
SENTRY_DSN=

# ---- HTTP edge ----
# Comma-separated browser origins allowed to call the API and open sockets,
# e.g. the admin panel: https://admin.easzygoo.com,http://localhost:3000
# Requests with no Origin (native mobile apps) are always allowed; unknown
# browser origins get 403. Unset = no browser origins allowed.
ALLOWED_ORIGINS=
# Number of reverse proxies in front of the app (Cloudflare + Nginx = 2), or
# true/false. Required behind a proxy, otherwise every client shares the proxy's
# IP and per-IP rate limits throttle everyone together. Unset = false.
TRUST_PROXY=

# ---- Tests (apps/backend `pnpm test`) ----
# A DEDICATED database the suite may wipe. It refuses to run if this is unset or
# is the same database as DATABASE_URL.
TEST_DATABASE_URL=

# Payment keys (Razorpay, Cashfree) are added here when the code that reads them lands.
