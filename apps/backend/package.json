{
  "name": "@easzygoo/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/workers/notification-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "get-test-token": "tsx scripts/get-test-token.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "promote-admin": "tsx scripts/promote-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^10.73.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "firebase-admin": "^14.3.0",
    "ioredis": "^6.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "firebase": "^12.18.0",
    "prisma": "^5.20.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
